# img_gen 환경변수
# .env 로 복사 후 값 채우기. .env 는 .gitignore 에 등록되어 있어 커밋 안 됨.

# ── OpenAI API key (필수) ────────────────────────────────────────
# https://platform.openai.com/api-keys 에서 발급.
# 이미지 모델 사용하려면 결제 수단 등록 필요.
OPENAI_API_KEY=sk-...

# ── 모델 ID (옵션, default: gpt-image-1) ────────────────────────
# 2026-05 기준 공식 모델은 gpt-image-1. gpt-image-2 출시되면 이 줄로 오버라이드.
# OPENAI_IMAGE_MODEL=gpt-image-1

# 픽커 탭의 "+ 1장 생성" 모델 드롭다운 후보.
# 실제 계정에서 호출 가능한 모델만 콤마로 나열.
# OPENAI_IMAGE_MODELS=gpt-image-1

# ── 출력 폴더 (옵션) ─────────────────────────────────────────────
# default: 이 .env 파일 옆 ./output/
# 절대경로로 다른 곳 (예: 큰 외장 디스크) 지정 가능.
# IMG_GEN_OUTPUT_DIR=/absolute/path/to/output
